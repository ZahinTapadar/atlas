{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["**/*.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(webp|png|jpg|svg|mp4|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ]
  }
}
